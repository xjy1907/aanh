#if __has_include(<AvailabilityVersions.h>)
    #import <AvailabilityVersions.h>
#endif

#ifdef __OBJC__
    #if __has_include(<TargetConditionals.h>)
        #import <TargetConditionals.h>
    #endif

    #import <Foundation/Foundation.h>
    #import <UIKit/UIKit.h>
    #import <os/log.h>
    #import "rootless.h"
    #import "NSUserDefaults+Private.h"
    #import "NHIdentity.h"
    // 每机派生（见 NHIdentity.h），不再使用固定 com.nh.notification.*
    #define NOTIFY_LAUNCHED_HUD  NHNotifyName("launched")
    #define NOTIFY_DISMISSAL_HUD NHNotifyName("dismissal")
    #define NOTIFY_RELOAD_HUD    NHNotifyName("reload")
    #define NOTIFY_RELOAD_APP    NHNotifyName("appreload")
    #define NOTIFY_PAUSE_HUD     NHNotifyName("pause")   // 隐藏叠层，进程与 krkw 保留（可再次开启）
    #define NOTIFY_RESUME_HUD    NHNotifyName("resume")  // 重新显示叠层
#endif

#if DEBUG
    #define log_debug os_log_debug
    #define log_info os_log_info
    #define log_error os_log_error
#else
    #define log_debug(...)
    #define log_info(...)
    #define log_error(...)
#endif

#define FADE_OUT_DURATION 0.25

#if !NO_TROLL
    #define USER_DEFAULTS_PATH @"/var/mobile/Library/Preferences/com.apple.iBooks.plist"
#else
    #define USER_DEFAULTS_PATH ([[NSSearchPathForDirectoriesInDomains(NSLibraryDirectory, NSUserDomainMask, YES) firstObject] stringByAppendingPathComponent:@"com.apple.iBooks.plist"])
#endif

